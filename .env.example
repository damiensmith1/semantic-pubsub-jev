# TypeSafe API key for Jev. Copy this file to .env and fill it in; .env is
# gitignored.
#
# Live calls cost money: input tokens are billed at $0.042/Mtok, output is
# free. Only the measurement harness calls the real API — unit tests use a
# stubbed judge and integration tests use the keyword judge.
TYPESAFE_API_KEY=

# Where the broker listens.
LISTEN_ADDR=:8080

# Prometheus metrics, on a separate listener. Empty disables.
METRICS_ADDR=

# Redis, shared with the broker. Interests are cluster-wide state.
REDIS_ADDRS=localhost:6379

# Pin a versioned model such as jev-1.13.0 for a measurement run. Empty
# uses the moving `jev-latest` alias, which is fine for development and
# wrong for M1 -- a run spanning two model versions measures the release,
# not the stability.
JEV_MODEL=

# Backstop for interests whose connection died without cleanup. Refreshed
# at a third of this while the connection is held, so it only ever expires
# interests that have genuinely gone away.
INTEREST_TTL_MS=3600000

LOG_LEVEL=info

# Probability at or above which a subscriber's interest counts as a match.
# Provisional: M3 exists to find out whether this is the right dial.
MATCH_THRESHOLD=0.5

# Bound on one Jev call. It sits on the publish path, so an unbounded one
# would stall the publishing client.
JUDGE_TIMEOUT_MS=5000
